# Database Connection (PostgreSQL with pgvector, or fallback SQLite)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/intellidesk

# Security & Authentication
JWT_SECRET=intellidesk_secret_jwt_key_2026_northbridge_super_secure

# Allowed CORS Origins (comma-separated list, including Vercel frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://intellidesk-ai-customer-support-gules.vercel.app

# Google Gemini API Key for LangGraph Agent & Embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Redis URL (Optional for multi-instance SSE pub/sub; defaults to in-memory)
REDIS_URL=

# Host & Port Settings
HOST=0.0.0.0
BACKEND_PORT=8000

# Copilot Autonomy flag
COPILOT_AUTONOMY=true
