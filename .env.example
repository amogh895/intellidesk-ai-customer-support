# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/intellidesk

# LLM & Embedding Adapter Configuration
# Options: 'openai_compatible', 'ollama', 'gemini'
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=sentence_transformers

# Provider Credentials / Endpoints
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=your_gemini_api_key_here

# Enterprise Copilot & HITL Parameters
COPILOT_AUTONOMY=true
HITL_PAYOUT_THRESHOLD=80000.0
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
